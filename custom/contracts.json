      "count": 1
    },
    {
      "id": "key-routing-dispatch",
      "file": "backend/internal/server/routes/gateway.go",
      "function": "RegisterGatewayRoutes",
      "call": "handler.KeyRouteDispatch",
      "count": 5
    },
    {
      "id": "key-account-dispatch",
      "file": "backend/internal/handler/key_route_dispatch.go",
      "function": "KeyRouteDispatch",
      "call": "runKeyAccountRouteDispatch",
      "count": 1
    },
