        "frontend/src/features/prompt-audit/",
        "frontend/src/features/gateway-resilience/",
        "frontend/src/features/key-routing/"
      ],
      "forbidden_import_prefixes": [
        "@/router",
        "@/views/admin/SettingsView",
        "@/components/layout/AppSidebar"
      ]
    }
  ],
