      "function": "initializeApplication",
      "call": "repository.ProvideKeyAccountHealthStore",
      "count": 1
    },
    {
      "id": "key-account-runtime-wire",
      "file": "backend/cmd/server/wire_gen.go",
      "function": "initializeApplication",
      "call": "service.ProvideKeyAccountRoutingRuntime",
      "count": 1
    },
