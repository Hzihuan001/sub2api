# Copy to a private .env.custom file and load it with the custom compose
# overlay.  Do not commit real credentials or API keys.
SUB2API_IMAGE=ghcr.io/hzihuan001/sub2api:custom-version

BATCH_IMAGE_ENABLED=true
BATCH_IMAGE_QUEUE_ENABLED=true
BATCH_IMAGE_DEFAULT_IMAGE_SIZE=2K
BATCH_IMAGE_APP_MANAGED_ENABLED=true

# Optional Kiro compatibility settings.
SUB2API_KIRO_TIME_CONTEXT=
SUB2API_KIRO_CONVERSATION_ID_MODE=stable
